   <text:p text:style-name="Title">Fidelity Sample</text:p>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">First Heading</text:h>
   <text:p text:style-name="P1">Plain text with <text:span text:style-name="T1">bold</text:span>, <text:span text:style-name="T2">italic</text:span>, <text:span text:style-name="T3">underlined</text:span>, <text:span text:style-name="T4">struck</text:span>, E=mc<text:span text:style-name="T5">2</text:span>, H<text:span text:style-name="T6">2</text:span>O, <text:span text:style-name="T7">red text</text:span>, <text:span text:style-name="T8">highlighted</text:span>, <text:span text:style-name="T9">monospace</text:span>, <text:span text:style-name="T10">Small Caps</text:span> and <text:span text:style-name="T11">big blue</text:span>. A link to <text:a xlink:type="simple" xlink:href="https://example.org/page">the example site</text:a> and a footnote<text:note text:id="ftn1" text:note-class="footnote"><text:note-citation>1</text:note-citation><text:note-body><text:p text:style-name="Footnote">This is the footnote text.</text:p></text:note-body></text:note> and an endnote<text:note text:id="edn1" text:note-class="endnote"><text:note-citation>i</text:note-citation><text:note-body><text:p text:style-name="Footnote">This is the endnote text.</text:p></text:note-body></text:note>.</text:p>
   <text:p text:style-name="Text_20_body">Commented <office:annotation office:name="c1"><dc:creator>Commenter</dc:creator><dc:date>2024-03-02T09:00:00</dc:date><text:p>Please check this phrase.</text:p></office:annotation>phrase here<office:annotation-end office:name="c1"/> and tracked: <text:change-start text:change-id="ct1"/>inserted words <text:change-end text:change-id="ct1"/><text:change text:change-id="ct2"/>end.</text:p>
   <text:p text:style-name="Note_20_Para">A custom styled paragraph with indentation and shading.</text:p>
